---
import { site } from "../data/site";

interface Props {
	appsPage?: boolean;
}

const { appsPage = false } = Astro.props;
const writingHref = appsPage ? "https://ansonate.ink/#writing" : "#writing";
const appsHref = appsPage ? "/apps" : "#apps";
---

<header class="site-header">
	<div class="header-inner">
		<a class="brand" href={appsPage ? "/" : "#top"} aria-label="ANSONATE — home">
			<img src="/images/avatar.jpg" alt="" width="34" height="34" />
			<span class="brand-name">ANSONATE</span>
			<span class="brand-handle">Anson2251</span>
		</a>

		<nav class="nav" aria-label="Primary">
			<a href={writingHref}>Writing</a>
			<a href={appsHref} aria-current={appsPage ? "page" : undefined}>Apps</a>
			<a class="nav-linkedin" href={site.linkedinUrl} target="_blank" rel="noreferrer">
				LinkedIn<span aria-hidden="true"> ↗</span>
			</a>
			<a class="nav-github" href={site.githubUrl} target="_blank" rel="noreferrer">
				GitHub<span aria-hidden="true"> ↗</span>
			</a>
			<button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme">
				<svg
					class="icon-moon"
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.6"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M20.7 13.2A8.5 8.5 0 0 1 10.8 3.3a8.5 8.5 0 1 0 9.9 9.9Z"></path>
				</svg>
				<svg
					class="icon-sun"
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.6"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
				</svg>
			</button>
		</nav>
	</div>
</header>

<script>
	const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

	if (button) {
		const syncLabel = () => {
			const dark = document.documentElement.classList.contains("dark");
			button.setAttribute("aria-pressed", String(dark));
			button.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
		};

		syncLabel();

		button.addEventListener("click", () => {
			const root = document.documentElement;
			const dark = !root.classList.contains("dark");
			root.classList.toggle("dark", dark);
			root.style.colorScheme = dark ? "dark" : "light";

			try {
				localStorage.setItem("theme", dark ? "dark" : "light");
			} catch {
				// Ignore storage failures; the theme still applies for this page.
			}

			syncLabel();
		});
	}
</script>
