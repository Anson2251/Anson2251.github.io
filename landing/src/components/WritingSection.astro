---
import { Image } from 'astro:assets';
import CoopPill from "./CoopPill.astro";
import posts from "../data/posts.json";
import { site } from "../data/site";

function formatDate(value: string): string {
	const [year, month, day] = value.split("-");
	return `${year}.${month}.${day}`;
}
---

<section id="writing" class="screen writing-screen" aria-labelledby="writing-title">
	<div class="writing-grid">
		<div class="writing-copy">
			<CoopPill />
			<p class="eyebrow">Anson2251 <span aria-hidden="true">/</span> Writing</p>
			<h1 id="writing-title" class="display">{site.tagline}</h1>
			<p class="lede">{site.intro}</p>

			<div class="writing-list-block">
				<h2 class="list-label">Recent writing</h2>
				<div class="writing-list-wrap">
					<ul class="writing-list">
						{
							posts.map((post) => (
								<li title={post.title}>
									<a class="writing-row" href={post.url}>
										<time datetime={post.published}>{formatDate(post.published)}</time>
										<span class="writing-title">{post.title}</span>
										<span class="writing-meta">{post.category}</span>
										<span class="writing-arrow" aria-hidden="true">↗</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>

			<a class="text-link" href={site.blogUrl}>
				All writing <span aria-hidden="true">→</span>
			</a>
		</div>

		<figure class="writing-art">
			<Image src="/images/banner.jpg" alt="" width="1448" height="1086" fetchpriority="high" />
			<figcaption class="art-caption">
				<span>University Ave, near UWaterloo</span>
				<span>Photo by Anson2251</span>
				<span>Paint filter by GPT Image 2.5</span>
			</figcaption>
		</figure>
	</div>

	<a class="scroll-cue" href="#apps">
		Apps &amp; experiments <span aria-hidden="true">↓</span>
	</a>
</section>
