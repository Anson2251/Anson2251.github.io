---
import { site } from "../data/site";

const { coop } = site;
const Tag = coop.href ? "a" : "span";
const label = `Open to co-op for ${coop.term} — ${coop.program}, ${coop.school}, ${coop.level}`;
---

{
	coop.open && (
		<Tag
			class="coop-pill"
			href={coop.href || undefined}
			aria-label={coop.href ? `${label}. Get in touch.` : undefined}
		>
			<span class="coop-dot" aria-hidden="true" />
			<strong>Open to co-op</strong>
			<span class="coop-sep" aria-hidden="true">·</span>
			<span>{coop.term}</span>
			<span class="coop-sep" aria-hidden="true">·</span>
			<span>{coop.program}, {coop.school}</span>
			<span class="coop-sep" aria-hidden="true">·</span>
			<span>{coop.level}</span>
		</Tag>
	)
}
