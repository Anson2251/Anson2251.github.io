---
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { url } from "../utils/url-utils";

const title = i18n(I18nKey.notFoundTitle);
const description = i18n(I18nKey.notFoundDescription);
---

<MainGridLayout title={title} description={description}>
    <Fragment slot="head">
        <meta name="robots" content="noindex" />
    </Fragment>

    <div class="flex w-full rounded-[var(--radius-large)] relative min-h-32">
        <div class="card-base z-10 px-6 py-14 md:px-9 md:py-20 relative w-full flex flex-col items-center text-center">
            <div class="font-bold text-[clamp(4rem,12vw,7rem)] leading-none tracking-[-0.06em] text-[var(--primary)] select-none">
                404
            </div>
            <h1 class="mt-5 text-2xl md:text-3xl font-bold text-90" data-i18n={I18nKey.notFoundTitle}>
                {title}
            </h1>
            <p class="mt-3 max-w-md text-75" data-i18n={I18nKey.notFoundDescription}>
                {description}
            </p>
            <div class="mt-8 flex flex-wrap justify-center gap-3">
                <a href={url("/")} class="btn-regular rounded-lg h-10 px-5 font-bold active:scale-95">
                    <span data-i18n={I18nKey.backHome}>{i18n(I18nKey.backHome)}</span>
                </a>
                <a href={url("/archive/")} class="btn-plain rounded-lg h-10 px-5 font-bold">
                    <span data-i18n={I18nKey.archive}>{i18n(I18nKey.archive)}</span>
                </a>
            </div>
        </div>
    </div>
</MainGridLayout>
